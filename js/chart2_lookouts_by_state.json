{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 320,

  "data": {
    "url": "data/scenic_walks_lookouts.csv"
  },

  "transform": [
    {
      "filter": "datum.type == 'LOOKOUT'"
    },
    {
      "filter": "datum.state != 'AAD'"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#3F6E63"
      },

      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": "-x"
        },

        "x": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Number of Recorded Lookouts"
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Recorded Lookouts"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#18312D"
      },

      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": "-x"
        },

        "x": {
          "aggregate": "count",
          "type": "quantitative"
        },

        "text": {
          "aggregate": "count",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}