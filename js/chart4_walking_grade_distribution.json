{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 430,

  "data": {
    "url": "data/nsw_scenic_lookout_walks_case_study.csv",
    "format": {
      "type": "csv",
      "parse": {
        "grade": "number",
        "time_mid_min": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.grade >= 1 && datum.grade <= 4"
    }
  ],

  "mark": {
    "type": "boxplot",
    "extent": "min-max",
    "size": 65
  },

  "encoding": {
    "x": {
      "field": "grade",
      "type": "ordinal",
      "title": "Walking Track Grade",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13
      }
    },

    "y": {
      "field": "time_mid_min",
      "type": "quantitative",
      "title": "Typical Walking Time (minutes)",
      "scale": {
        "domain": [0, 120],
        "zero": true
      },
      "axis": {
        "labelFontSize": 13,
        "titleFontSize": 14
      }
    },

    "color": {
      "field": "grade",
      "type": "ordinal",
      "legend": null,
      "scale": {
        "scheme": "viridis"
      }
    },

    "tooltip": [
      {
        "field": "grade",
        "type": "ordinal",
        "title": "Grade"
      },
      {
        "field": "time_mid_min",
        "type": "quantitative",
        "title": "Walking time (min)"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#E8E4DC"
    }
  }
}